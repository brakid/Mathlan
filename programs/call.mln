!include stdlib.mln

# [ret]
printDone:
    'D' 100 store
    'o' 101 store
    'n' 102 store
    'e' 103 store
    10 104 store
    5 100 printText call
    0 # [ret value]
    swap # [value ret]
    ret # [value]

# [ret]
printError:
    'E' 105 store
    'r' 106 store
    'r' 107 store
    'o' 108 store
    'r' 109 store
    10 110 store
    6 105 printText call
    0 # [ret value]
    swap # [value ret]
    ret # [value]

main:
    42
    513
    0
    store2bytes call
    printDone call
    0 = if
    else printError call drop
    end
    0 load2bytes call
    print
    print