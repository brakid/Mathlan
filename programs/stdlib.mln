# [text_len text_address ret]
printText:
    rot # [text_address ret text_len]
    rot # [ret text_len text_address]
    swap # [ret text_address text_len]
printTextLoop:
    dup # [ret text_address text_len text_len]
    1 < if # [ret text_address text_len]
        drop # [ret text_address]
        drop # [ret]
    else # [ret text_address text_len]
        swap # [ret text_len text_address]
        dup # [ret text_len text_address text_address]
        load # [ret text_len text_address text_char]
        putc # [ret text_len text_address]
        1 + # [ret text_len text_address+]
        swap # [ret text_address+ text_len]
        1 - # [ret text_address+ text_len-]
        printTextLoop jump
    end
    ret

# [value address ret]
store2bytes:
    rot # [ret value address]
    swap # [ret address value]
    dup # [ret address value value]
    rot # [ret value address value]
    swap # [ret value value address]
    dup # [ret value value address address]
    rot # [ret value address value address]
    swap # [ret value address address value]
    256 % # [ret value address address value_mod]
    swap # [ret value address lsb_value address]
    store # [ret value address]
    1 + # [ret value address+1]
    swap # [ret address+1 value]
    256 / # [ret address+1 msb_value]
    swap # [ret value_div address+1]
    store # [ret]
    ret

# [address ret] -> value
load2bytes:
    swap # [ret address]
    dup # [ret address address]
    1 +  # [ret address address+1]
    load # [ret address msb_value]
    256 * # [ret address msb_value]
    swap # [ret msb_value address]
    load # [ret msb_value lsb_value]
    + # [ret value]
    swap # [value ret]
    ret # [value]

#[str1len str1addr str2len str2addr ret] -> bool
compareText:
    5 roll #[str1addr str2len str2addr ret str1len]
    4 roll #[str1addr str2addr ret str1len str2len]
    swap #[str1addr str2addr ret str2len str1len]
    dup #[str1addr str2addr ret str2len str1len str1len]
    rot #[str1addr str2addr ret str1len str1len str2len]
    = not if #[str1addr str2addr ret str1len]
        drop #[str1addr str2addr ret]
        rot #[str2addr ret str1addr]
        rot #[ret str1addr str2addr]
        drop #[ret str1addr]
        drop #[ret]
        0 #[ret result]
        swap #[result ret]
    else #[str1addr str2addr ret str1len]
        4 roll #[str2addr ret str1len str1addr]
        4 roll #[ret str1len str1addr str2addr]
        rot #[ret str1addr str2addr str1len]
compareText_loop:
        dup #[ret str1addr str2addr str1len str1len]
        1 < if #[ret str1addr str2addr str1len]
            drop #[ret str1addr str2addr]
            drop #[ret str1addr]
            drop #[ret]
            1 #[ret value]
            swap #[value ret]
        else #[ret str1addr str2addr str1len]
            rot #[ret str2addr str1len str1addr]
            dup #[ret str2addr str1len str1addr str1addr]
            4 roll #[ret str1len str1addr str1addr str2addr]
            4 roll #[ret str1addr str1addr str2addr str1len]
            swap #[ret str1addr str1addr str1len str2addr]
            dup #[ret str1addr str1addr str1len str2addr str2addr]
            4 roll #[ret str1addr str1len str2addr str2addr str1addr]
            4 roll #[ret str1addr str2addr str2addr str1addr str1len]
            rot #[ret str1addr str2addr str1addr str1len str2addr]
            rot #[ret str1addr str2addr str1len str2addr str1addr]
            load #[ret str1addr str2addr str1len str2addr str1val]
            swap #[ret str1addr str2addr str1len str1val str2addr]
            load #[ret str1addr str2addr str1len str1val str2val]
            = not if #[ret str1addr str2addr str1len]
                drop #[ret str1addr str2addr]
                drop #[ret str1addr]
                drop #[ret]
                0 #[ret value]
                swap #[value ret]
            else #[ret str1addr str2addr str1len]
                1 - #[ret str1addr str2addr str1len-]
                rot #[ret str2addr str1len- str1addr]
                1 + #[ret str2addr str1len- str1addr+]
                rot #[ret str1len- str1add+ str2addr]
                1 + #[ret str1len- str1add+ str2addr+]
                rot #[ret str1add+ str2addr str1len-]
                compareText_loop jump #[ret str1add+ str2addr str1len-]
            end
        end
    end
    ret #[result]

copyText: #[strlen straddr targetaddr ret] -> targetlen
    0 #[strlen straddr targetaddr ret targetlen]
    rot #[strlen straddr ret targetlen targetaddr]
    swap #[strlen straddr ret targetaddr targetlen]
    5 roll #[straddr ret targetaddr targetlen strlen]
    5 roll #[ret targetaddr targetlen strlen straddr]
    swap #[ret targetaddr targetlen straddr strlen]
copyText_loop:
    dup #[ret targetaddr targetlen straddr strlen strlen]
    1 < if #[ret targetaddr targetlen straddr strlen]
        drop #[ret targetaddr targetlen straddr]
        drop #[ret targetaddr targetlen]
        swap #[ret targetlen targetaddr]
        drop #[ret targetlen]
        swap #[targetlen ret]
    else #[ret targetaddr targetlen straddr strlen]
        4 roll #[ret targetlen straddr strlen targetaddr]
        rot #[ret targetlen strlen targetaddr straddr]
        dup #[ret targetlen strlen targetaddr straddr straddr]
        load #[ret targetlen strlen targetaddr straddr strval]
        rot #[ret targetlen strlen straddr strval targetaddr]
        dup #[ret targetlen strlen straddr strval targetaddr targetaddr]
        rot #[ret targetlen strlen straddr targetaddr targetaddr strval]
        swap #[ret targetlen strlen straddr targetaddr strval targetaddr]
        store #[ret targetlen strlen straddr targetaddr]
        1 + #[ret targetlen strlen straddr targetaddr+]
        4 roll #[ret strlen straddr targetaddr+ targetlen]
        1 + #[ret strlen straddr targetaddr+ targetlen+]
        4 roll #[ret straddr targetaddr+ targetlen+ strlen]
        1 - #[ret straddr targetaddr+ targetlen+ strlen-]
        4 roll #[ret targetaddr+ targetlen+ strlen- straddr]
        1 + #[ret targetaddr+ targetlen+ strlen- straddr+]
        swap #[ret targetaddr+ targetlen+ straddr+ strlen-]
        copyText_loop jump #[ret targetaddr+ targetlen+ straddr+ strlen-]
    end
    ret #[targetlen]

concatText: #[str1len str1addr str2len str2addr targetaddr ret] -> targetlen (str1+str2)
    6 roll #[str1addr str2len str2addr targetaddr ret str1len]
    5 roll #[str1addr str2addr targetaddr ret str1len str2len]
    4 roll #[str1addr str2addr ret str1len str2len targetaddr]
    5 roll #[str1addr ret str1len str2len targetaddr str2addr]
    4 roll #[str1addr ret str2len targetaddr str2addr str1len]
    4 roll #[str1addr ret targetaddr str2addr str1len str2len]
    4 roll #[str1addr ret str2addr str1len str2len targetaddr]
    rot #[str1addr ret str2addr str2len targetaddr str1len]
    dup #[str1addr ret str2addr str2len targetaddr str1len str1len]
    rot #[str1addr ret str2addr str2len str1len str1len targetaddr]
    dup #[str1addr ret str2addr str2len str1len str1len targetaddr targetaddr]
    rot #[str1addr ret str2addr str2len str1len targetaddr targetaddr str1len]
    + #[str1addr ret str2addr str2len str1len targetaddr target2addr]
    5 roll #[str1addr ret str2len str1len targetaddr target2addr str2addr]
    5 roll #[str1addr ret str1len targetaddr target2addr str2addr str2len]
    rot #[str1addr ret str1len targetaddr str2addr str2len target2addr]
    rot #[str1addr ret str1len targetaddr str2len target2addr str2addr]
    rot #[str1addr ret str1len targetaddr target2addr str2addr str2len]
    swap #[str1addr ret str1len targetaddr target2addr str2len str2addr]
    rot #[str1addr ret str1len targetaddr str2len str2addr target2addr]
    copyText call #[str1addr ret str1len targetaddr target2len]
    5 roll #[ret str1len targetaddr target2len str1addr]
    4 roll #[ret targetaddr target2len str1addr str1len]
    4 roll #[ret target2len str1addr str1len targetaddr]
    rot #[ret target2len str1len targetaddr str1addr]
    rot #[ret target2len targetaddr str1addr str1len]
    swap #[ret target2len targetaddr str1len str1addr]
    rot #[ret target2len str1len str1addr targetaddr]
    copyText call #[ret target2len targetlen]
    + #[ret totaltargetlen]
    swap #[totaltargetlen ret]
    ret #[totaltargetlen]