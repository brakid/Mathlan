!include stdlib.mln

newlineaddr= 4000
newLine:
    10 newlineaddr store
    1 newlineaddr
    rot
    ret

spaceaddr= 4001
concat1addr= 4020
concat2addr= 4040
concat3addr= 4060
concat4addr= 4080
vsText: #[ret] -> " not equals "
    32 spaceaddr store #[ret]
    1 spaceaddr #[ret spacelen spaceaddr]
    "not" #[ret str1len str1addr str2len str2addr]
    concat1addr #[ret str1len str1addr str2len str2addr concat1addr]
    concatText call #[ret concat1len]
    concat1addr #[ret concat1len concat1addr]
    1 spaceaddr #[ret concat1len concat1addr spacelen spaceaddr]
    concat2addr #[ret concat1len concat1addr str1len str1addr concat2addr]
    concatText call #[ret concat2len]
    concat2addr #[ret concat2len concat2addr]
    "equals" #[ret concat2len concat2addr str3len str3addr]
    concat3addr #[ret concat2len concat2addr str3len str3addr concat3addr]
    concatText call #[ret concat3len]
    concat3addr #[ret concat3len concat3addr]
    1 spaceaddr #[ret concat3len concat3addr spacelen spaceaddr]
    concat4addr #[ret concat3len concat3addr spacelen spaceaddr concat4addr]
    concatText call #[ret concat4len]
    concat4addr #[ret concat4len concat4addr]
    rot #[concat4len concat4addr ret]
    ret

mainconcat1addr= 4100
mainconcat2addr= 4150
mainconcat3addr= 4200
main:
    "Hello" #[str1len str1addr]
    dup #[str1len str1addr str1addr]
    rot #[str1addr str1addr str1len]
    dup #[str1addr str1addr str1len str1len]
    4 roll #[str1addr str1len str1len str1addr]
    "World" #[str1addr str1len str1len str1addr str2len str2addr]
    dup #[str1addr str1len str1len str1addr str2len str2addr str2addr]
    rot #[str1addr str1len str1len str1addr str2addr str2addr str2len]
    dup #[str1addr str1len str1len str1addr str2addr str2addr str2len str2len]
    4 roll #[str1addr str1len str1len str1addr str2addr str2len str2len str2addr]
    6 roll #[str1addr str1len str1addr str2addr str2len str2len str2addr str1len]
    6 roll #[str1addr str1len str2addr str2len str2len str2addr str1len str1addr]
    compareText call #[str1addr str1len str2addr str2len result]
    1 = if #[str1addr str1len str2addr str2len]
        "Same" printText call #[str1addr str1len str2addr str2len]
        drop
        drop
        drop
        drop
    else #[str1addr str1len str2addr str2len]
        4 roll #[str1len str2addr str2len str1addr]
        rot #[str1len str2len str1addr str2addr]
        rot #[str1len str1addr str2addr str2len]
        swap #[str1len str1addr str2len str2addr]
        4 roll #[str1addr str2len str2addr str1len]
        4 roll #[str2len str2addr str1len str1addr]
        vsText call #[str2len str2addr str1len str1addr str3len str3addr]
        mainconcat1addr #[str2len str2addr str1len str1addr str3len str3addr mainconcat1addr]
        concatText call #[str2len str2addr mainconcat1len]
        mainconcat1addr #[str2len str2addr mainconcat1len mainconcat1addr]
        4 roll #[str2addr mainconcat1len mainconcat1addr str2len]
        4 roll #[mainconcat1len mainconcat1addr str2len str2addr]
        newLine call #[mainconcat1len mainconcat1addr str2len str2addr newlinelen newlineaddr]
        mainconcat2addr #[mainconcat1len mainconcat1addr str2len str2addr newlinelen newlineaddr mainconcat2addr]
        concatText call #[mainconcat1len mainconcat1addr mainconcat2len]
        mainconcat2addr #[mainconcat1len mainconcat1addr mainconcat2len mainconcat2addr]
        mainconcat3addr #[mainconcat1len mainconcat1addr mainconcat2len mainconcat2addr mainconcat3addr]
        concatText call #[mainconcat3len]
        mainconcat3addr #[mainconcat3len mainconcat3addr]
        printText call
    end