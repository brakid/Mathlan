!include stdlib.mln

concat: #[str1len str1addr str2len str2addr ret]
    5 roll #[str1addr str2len str2addr ret str1len]
    5 roll #[str2len str2addr ret str1len str1addr]
    5 roll #[str2addr ret str1len str1addr str2len]
    5 roll #[ret str1len str1addr str2len str2addr]
    3 pull #[ret str1len str1addr str2len str2addr str1len]
    2 pull #[ret str1len str1addr str2len str2addr str1len str2len]
    + #[ret str1len str1addr str2len str2addr str3len]
    allocateMemory call #[ret str1len str1addr str2len str2addr str3addr]
    5 roll #[ret str1addr str2len str2addr str3addr str1len]
    5 roll #[ret str2len str2addr str3addr str1len str1addr]
    5 roll #[ret str2addr str3addr str1len str1addr str2len]
    5 roll #[ret str3addr str1len str1addr str2len str2addr]
    4 pull #[ret str3addr str1len str1addr str2len str2addr str3addr]
    concatText call #[ret str3addr str3len]
    swap #[ret str3len str3addr]
    rot #[str3len str3addr ret]
    ret

to_text: #[value ret]
    swap # [ret value]
    1 dup allocateMemory call #[ret value strlen straddr]
    dup #[ret value strlen straddr straddr]
    4 roll #[ret strlen straddr straddr value]
    swap #[ret strlen straddr value straddr]
    store #[ret strlen straddr]
    rot #[strlen straddr ret]
    ret #[strlen straddr]

main:
    initMemory call
    "Hello" #[str1len str1addr]
    32 to_text call #[str1len str1addr str2len str2addr]
    concat call #[str3len str3addr]
    "World" #[str3len str3addr str4len str4addr]
    concat call #[str5len str5addr]
    10 to_text call #[str5len str5addr str6len str6addr]
    concat call #[str7len str7addr]
    1 pull #[str7len str7addr str7len]
    1 pull #[str7len str7addr str7len str7addr]
    printText call #[str7len str7addr]
    print #[str7len] #1009
    print #[] #4
